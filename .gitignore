```gitignore
# Compiled Python files
*.pyc
__pycache__/

# Virtual environments
venv/
.venv/
.env
.env.local
*.env.*

# Build/dist directories
build/
dist/
*.egg-info/

# Logs
*.log

# Temporary files
*.tmp
*.swp

# IDE specific
.vscode/
.idea/

# OS specific
.DS_Store
Thumbs.db

# Testing
.coverage
htmlcov/
.coverage.*
.cache/
.pytest_cache/
.mypy_cache/
```